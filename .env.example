# Copy to .env and adjust. .env is gitignored.
#
# Read by both the API and the `sql-agent` CLI. The `api` container overrides
# the database URLs — from in there, localhost is the container.

# --- two databases ---------------------------------------------------------
# The agent's memory and the data it queries are on separate servers, so
# neither can reach the other. There is deliberately no single DATABASE_URL and
# no fallback between these: a fallback is exactly how both connections end up
# back on one server, which is the thing being prevented.

# What the agent has learned: cache_entry, turn, LangGraph's checkpoints.
# Schema comes from migrations/*.sql. Port 5433.
AGENT_DATABASE_URL=postgresql://agent:agent@localhost:5433/agent

# The built-in target, registered as the connection named `default`. `reader`
# holds SELECT and nothing else. Locally this is the demo database built by
# demo/demo.sql; point it at a real warehouse and the name still reads true.
# Every *other* database is registered at runtime with
# `sql-agent connections create`, and lives in the connection table. Port 5432.
#
# A URL, not libpq keyword form (`host=x dbname=y`) — this is parsed by
# SQLAlchemy now. The scheme picks the driver; a bare `postgresql://` is
# normalised to `postgresql+psycopg`, and `mysql://` and `sqlite://` work too.
TARGET_DATABASE_URL=postgresql://reader:reader@localhost:5432/business

# The owner connection. Nothing in app/ reads it — it exists for the test
# harness, which has to create and populate a database, and for applying
# demo/demo.sql from outside Docker.
TARGET_ADMIN_URL=postgresql://business:business@localhost:5432/business

# --- the API ---------------------------------------------------------------
# Everything under /v1 requires this token; /health does not. Empty leaves the
# API open, which is fine locally but means an unauthenticated DELETE can wipe
# everything the agent has learned — and register a connection to somebody
# else's database. The server warns at startup.
# API_TOKEN=

# Encrypts registered warehouse passwords at rest on agent-db. Empty stores them
# in plaintext and the server warns, the same bargain API_TOKEN makes above.
# Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Read app/secrets.py before relying on it — it protects a stolen database dump
# and nothing at all against a compromised API process.
# CONNECTION_SECRET=

# --- the CLI ---------------------------------------------------------------
# `sql-agent` is a pure HTTP client and reads only these two. Both have working
# defaults, so a local checkout needs neither — set this one to point the CLI at
# a server somewhere else. Note the /v1: it is the base the CLI appends
# /connections, /ask, /cache and /turns to.
# SQL_AGENT_URL=http://localhost:8000/v1

# Must match API_TOKEN above. Two names because they are two things: what the
# client presents, and what the server expects. The 401 message names both.
# SQL_AGENT_API_KEY=

# Which connection commands default to, overriding `sql-agent connect` and
# overridden by -c. Useful in CI; leave unset interactively.
# SQL_AGENT_CONNECTION=default

# --- model -----------------------------------------------------------------
# Which model, at what effort, and within what bounds now live in
# config/config.yaml, which is tracked — read its comments for the key names.
# PROVIDER, MODEL, OPENAI_*, EFFORT_*, MAX_TOOL_CALLS, MAX_FIX_ATTEMPTS,
# STATEMENT_TIMEOUT_MS and MAX_ROWS were all read from here and are not any
# more; the server warns at startup if it finds one still set, because
# `extra="ignore"` makes a retired name and a typo look identical.
#
# What stayed here is the half that must never be in a tracked file: the keys.
#
# Set this here. The API runs in a container and does not inherit your shell,
# and the passthrough that would forward it is deliberately absent from
# docker-compose.yml — `environment` beats `env_file`, so a stale key exported
# in some terminal would silently win over this file and every turn would 401.
# ANTHROPIC_API_KEY=sk-ant-...
#
# For an openai_compat endpoint that wants one. Defaults to "not-needed",
# which is right for Ollama and LM Studio.
# OPENAI_API_KEY=

# Where config.yaml, config.local.yaml and prompts/ are. Rarely set: the
# default is the config/ directory in the repository, and it is what the api
# container gets both COPY'd and mounted. The test suite points it at a
# scratch copy. This replaced PROMPT_DIR.
# CONFIG_DIR=config

# --- observability ---------------------------------------------------------
# Tracing is on when both keys are set and off otherwise — there is no separate
# enable flag. Off is the default, and off costs nothing: no client is built and
# `langfuse` is never imported.
#
# On, every turn becomes one trace: a span per graph node, a generation per
# model call with its tokens and its cache reads, and a span per introspection
# tool call — the 24 that a T1 turn collapses into a single number today.
#
# It captures the question, the prompts, the generated SQL and the result rows
# handed back to the model. The stack is self-hosted, so none of that leaves this
# machine, but it does mean the trace store holds whatever the registered
# warehouse holds. Read app/tracing.py before pointing a connection at
# something real.
#
# Start it with `make langfuse-up` (six containers, ~2GB), open
# http://localhost:3000, and log in with the credentials in docker-compose.yml.
# These two keys are the ones that stack seeds itself with, so uncommenting them
# and `docker compose up -d api` is the whole setup — `restart` is not enough,
# because it reuses the environment the container was created with.
# LANGFUSE_PUBLIC_KEY=pk-lf-0000000000000000000000000000000000000000
# LANGFUSE_SECRET_KEY=sk-lf-0000000000000000000000000000000000000000
#
# Where the API looks for it. The container overrides this — from in there,
# localhost is the container — so this value is for host-side use only.
# LANGFUSE_HOST=http://localhost:3000
