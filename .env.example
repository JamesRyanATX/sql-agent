# Copy to .env and adjust. .env is gitignored.
#
# Read by both the API and the `sql-agent` CLI. The `api` container overrides
# the database URLs — from in there, localhost is the container.

# --- two databases ---------------------------------------------------------
# The agent's memory and the data it queries are on separate servers, so
# neither can reach the other. There is deliberately no single DATABASE_URL and
# no fallback between these: a fallback is exactly how both connections end up
# back on one server, which is the thing being prevented.

# What the agent has learned: cache_entry, turn, LangGraph's checkpoints.
# Schema comes from migrations/*.sql. Port 5433.
AGENT_DATABASE_URL=postgresql://agent:agent@localhost:5433/agent

# The built-in target, registered as the connection named `default`. `reader`
# holds SELECT and nothing else. Locally this is the demo database built by
# demo/demo.sql; point it at a real warehouse and the name still reads true.
# Every *other* database is registered at runtime with
# `sql-agent connections create`, and lives in the connection table. Port 5432.
TARGET_DATABASE_URL=postgresql://reader:reader@localhost:5432/business

# The owner connection. Nothing in app/ reads it — it exists for the test
# harness, which has to create and populate a database, and for applying
# demo/demo.sql from outside Docker.
TARGET_ADMIN_URL=postgresql://business:business@localhost:5432/business

# --- the API ---------------------------------------------------------------
# Everything under /v1 requires this token; /health does not. Empty leaves the
# API open, which is fine locally but means an unauthenticated DELETE can wipe
# everything the agent has learned — and register a connection to somebody
# else's database. The server warns at startup.
# API_TOKEN=

# Encrypts registered warehouse passwords at rest on agent-db. Empty stores them
# in plaintext and the server warns, the same bargain API_TOKEN makes above.
# Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Read app/secrets.py before relying on it — it protects a stolen database dump
# and nothing at all against a compromised API process.
# CONNECTION_SECRET=

# --- the CLI ---------------------------------------------------------------
# `sql-agent` is a pure HTTP client and reads only these two. Both have working
# defaults, so a local checkout needs neither — set this one to point the CLI at
# a server somewhere else. Note the /v1: it is the base the CLI appends
# /connections, /ask, /cache and /turns to.
# SQL_AGENT_URL=http://localhost:8000/v1

# Must match API_TOKEN above. Two names because they are two things: what the
# client presents, and what the server expects. The 401 message names both.
# SQL_AGENT_API_KEY=

# Which connection commands default to, overriding `sql-agent connect` and
# overridden by -c. Useful in CI; leave unset interactively.
# SQL_AGENT_CONNECTION=default

# --- model -----------------------------------------------------------------
# "anthropic" is the demo model. "openai_compat" is any OpenAI-shaped endpoint
# (Ollama, vLLM, LM Studio) for local development.
PROVIDER=anthropic

# Set it here. The API runs in a container and does not inherit your shell, and
# the passthrough that would forward it is deliberately absent from
# docker-compose.yml — `environment` beats `env_file`, so a stale key exported
# in some terminal would silently win over this file and every turn would 401.
# ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-opus-5

# Local development. Must not be localhost — the API runs in a container, where
# localhost is the container. Use a LAN IP or host.docker.internal.
# Note: on Ollama's MLX runner, `response_format` and the
# native `format` parameter are both silently ignored (no grammar-constrained
# decoding), so structured output goes through a forced tool call instead —
# app/llm.py handles this. Tool calling itself works fine.
# OPENAI_BASE_URL=http://192.168.68.54:11434/v1
# OPENAI_MODEL=qwen3.6:27b-mlx
# OPENAI_TIMEOUT=900
#
# If a turn crawls, check GPU contention before touching these — the same
# request measured 600s+ on a busy machine and 22s on a free one. Both caps
# still produce valid tool calls if you need to bound a turn.
# OPENAI_MAX_TOKENS=4000
# OPENAI_REASONING_EFFORT=low

# Per-node effort. See PLAN.md §7.1 — never disable thinking to save tokens.
EFFORT_PLAN=low
EFFORT_EXPLORE=high
EFFORT_SQL=high
EFFORT_EXTRACT=low

# Bounds, so T1 doesn't run forever on stage.
MAX_TOOL_CALLS=24
MAX_FIX_ATTEMPTS=3
STATEMENT_TIMEOUT=5s
