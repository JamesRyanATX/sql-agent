# cp .env.example .env
# cp config/config.local.yaml.example config/config.local.yaml
# make up && make migrate && make seed

# Your OpenRouter key. The only line you must edit.
OPENROUTER_API_KEY=sk-or-...

# Only if config.local.yaml says provider: anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# Only for an OpenAI-shaped endpoint. Ollama needs none.
# OPENAI_API_KEY=

# The three below already match what `make up` starts.

# What the agent learned: cache, turns, checkpoints.
# AGENT_DATABASE_URL=postgresql://agent:agent@localhost:5433/agent

# The database it answers questions about. Read-only role.
# TARGET_DATABASE_URL=postgresql://reader:reader@localhost:5432/business

# The test suite's owner login. The app never reads it.
# TEST_ADMIN_URL=postgresql://business:business@localhost:5432/business

# Required by every /v1 route. Empty leaves it open.
# API_TOKEN=

# Encrypts stored warehouse passwords. Empty keeps them plaintext.
# CONNECTION_SECRET=

# Where the CLI looks for the server.
# SQL_AGENT_URL=http://localhost:8000/v1

# Must match API_TOKEN above.
# SQL_AGENT_API_KEY=

# Where config.yaml and prompts/ live.
# CONFIG_DIR=config

# Tracing is on when both keys are set.
# Set them only once `make langfuse-up` is running.
# LANGFUSE_PUBLIC_KEY=pk-lf-0000000000000000000000000000000000000000
# LANGFUSE_SECRET_KEY=sk-lf-0000000000000000000000000000000000000000

# Host-side only. The container overrides this.
# LANGFUSE_HOST=http://localhost:3000
