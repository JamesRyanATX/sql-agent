# Merged over config.yaml, key by key. Gitignored.
# This runs OpenRouter, which OPENROUTER_API_KEY in .env pays for.

model:
  provider: openrouter
  model: google/gemini-2.5-flash
  url: https://openrouter.ai/api/v1

  # A cost lever here, not just a timeout: OpenRouter makes
  # effort a fraction of this, and thinking bills as output.
  # Raise it if answers get cut off mid-thought.
  max_tokens: 4000

# A cold turn on this costs well under a cent.
# model:
#   provider: openrouter
#   model: openai/gpt-oss-20b
#   url: https://openrouter.ai/api/v1
#   max_tokens: 4000

# A better model for the node that proposes rewrites.
# gepa:
#   model:
#     provider: openrouter
#     model: anthropic/claude-sonnet-5
#     url: https://openrouter.ai/api/v1

# Per-node effort. `none` is refused on Claude, which
# needs thinking on to call a tool at all.
# explore: {effort: medium}
